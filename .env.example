# API base including /api (must match kmdemo-backend mount).
# Local dev:
VITE_API_BASE_URL=http://localhost:3000/api
# Production (Vercel / CI): set to your public HTTPS API, e.g. https://api.yourdomain.com/api — required for /pricing checkout fetch; rebuild after changing.
# Optional: public site address used inside the download QR code (defaults to the address the page is opened on).
# VITE_SITE_URL=https://www.yourdomain.com
